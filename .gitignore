# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
scraper/scrape.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Claude Code project config (local only)
.claude/

# CodeGraph index — rebuilt from source, machine-local
.codegraph/

# Screen recordings and demo captures. "PlantAI POC.mov" is 138 MB; GitHub
# rejects pushes over 100 MB, and a video in git history cannot be removed
# without rewriting every commit after it.
*.mov
*.mp4

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
