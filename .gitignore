# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
scraper/scrape.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Claude Code project config (local only)
.claude/

# CodeGraph index - rebuilt from source, machine-local
.codegraph/

# Screen recordings and demo captures. "PlantAI POC.mov" is 138 MB; GitHub
# rejects pushes over 100 MB, and a video in git history cannot be removed
# without rewriting every commit after it.
*.mov
*.mp4

# local env files. Ignore EVERY .env variant and allow the example back in -
# `.env*.local` plus a bare `.env` left `.env.production` and `.env.staging`
# tracked, which are the two most likely to hold live keys.
.env*
!.env.example

# typescript
*.tsbuildinfo

# editors
.vscode/
.idea/
*.swp

# test/coverage output
coverage/
.nyc_output/

# archives - the assignment was submitted as a zip containing a live .env, and
# nothing in this repo should ever be a build artifact you committed by accident
*.zip
*.tar
*.tar.gz
*.tgz

# generated native folders
/ios
/android

# Personal working notes and assistant config. Local only: these describe how
# the author works, not how the project builds - build knowledge lives in
# docs/BUILD-NOTES.md, which IS tracked.
CLAUDE.md
TODOS.md
TODOS.original.md
TODOS.english.md
docs/superpowers/

# Coursework submission artifacts - the board screenshot write-up is handed in,
# not built from, and a 680 KB PDF has no business in a source tree.
PlantAI-kanban-board-annotated.pdf

# Long-form notes and write-ups. Local only: the repository carries the code
# and the API docs site, and these went stale faster than anyone reread them.
docs/BUILD-NOTES.md
docs/DESIGN-SYSTEM.md
docs/RETRIEVAL.md
docs/RUNBOOK.md
docs/SCRAPE-ACCURACY-PLAN.md

# graphify knowledge-graph output - regenerated on demand, not source
graphify-out/

# local test photos - inputs for manual diagnosis runs, not source
photos_for_testing/

# Run artifact from scripts/funnel-tally.ts - a measurement, not source.
scraper/funnel-tally.json

# gstack skill runtime state - local only, not source
.gstack/
