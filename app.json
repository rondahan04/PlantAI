{
  "expo": {
    "name": "PlantAI",
    "slug": "PlantAI",
    "version": "1.0.0",
    "scheme": "plantai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F1E7"
    },
    "ios": {
      "bundleIdentifier": "com.rondahan.PlantAI",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "he"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "PlantAI needs camera access to diagnose your plants.",
        "NSPhotoLibraryUsageDescription": "PlantAI needs photo library access to analyze plant photos.",
        "NSLocationWhenInUseUsageDescription": "PlantAI uses your location to find nearby nurseries."
      }
    },
    "android": {
      "package": "com.rondahan.PlantAI",
      "adaptiveIcon": {
        "backgroundColor": "#38D5C1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PlantAI needs camera access to diagnose your plants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantAI needs photo library access to analyze plant photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#38D5C1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E7",
          "dark": {
            "backgroundColor": "#14120E"
          }
        }
      ],
      "expo-localization"
    ],
    "owner": "rondahan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/57deeb39-7f1d-4f19-bc6c-76361f3dfc1d"
    },
    "extra": {
      "eas": {
        "projectId": "57deeb39-7f1d-4f19-bc6c-76361f3dfc1d"
      }
    }
  }
}
