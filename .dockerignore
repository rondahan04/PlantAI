# Everything is excluded by default; the Dockerfile COPYs only what the server
# reads at runtime. This list exists so an accidental `COPY . .` — or a `docker
# build` context upload — cannot carry the app source, the 138 MB demo video, or
# the .env full of live keys into an image that gets pushed to a registry.
.env
.env.*
!.env.example

node_modules
.git
.expo
.codegraph
.claude

# React Native app — never runs in the container.
src
assets
App.tsx
index.ts
app.json
app.config.js
design-system
docs
dashboard
scripts
photos_for_testing

*.mov
*.png
*.jpg
*.jpeg
scraper/scrape.log
**/*.test.ts
